# Ollama Cloud — required. See lib/llm.ts.
OLLAMA_API_KEY=

# ElevenLabs — TTS only (STT stays on the browser's own Web Speech API, no
# key needed). Optional: if unset, MeetingRoom falls back to text-only, no
# error shown. See lib/speech.ts, app/api/speech/route.ts, CLAUDE.md
# Failure Behavior.
ELEVENLABS_API_KEY=

# One ElevenLabs voice_id per persona used by the Scenario Agent (see
# lib/schemas.ts's voiceId enum). Voice IDs are account-specific — open
# your ElevenLabs dashboard's Voice Library, pick a voice, and copy its
# Voice ID. All four must be set for TTS to activate; any one missing is
# treated as ElevenLabs not being configured at all.
ELEVENLABS_VOICE_AF_SARAH=
ELEVENLABS_VOICE_AF_BELLA=
ELEVENLABS_VOICE_AM_ADAM=
ELEVENLABS_VOICE_AM_MICHAEL=
