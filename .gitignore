# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# >>> spec >>>
# Auto-managed by `spec init`. Re-run to update; or delete the whole
# block (sentinels included) to opt out.
# NOTE: gitignore has no trailing-comment syntax — a "pattern  # comment"
# line makes the whole line (comment included) the literal pattern, which
# then matches nothing. Keep comments on their own line above the pattern.
# Spec CLI's local index/staging directory.
.spec/
# Default `spec compile` output target — regenerated.
out/
# Claude Code per-user settings — never shared.
.claude/settings.local.json
# <<< spec <<<

# Claude Code — machine-local tooling, not project content.
# .claude/skills/ IS committed on purpose (the design-taste skills used to
# build this UI are part of the project's story); these are not.
# spec-tool hooks tied to this machine's local setup.
.claude/settings.json
# Scratch worktrees created by agent workflows.
.claude/worktrees/
# Generic superpowers workflow docs — tooling config, not project content.
.claude/commands/
